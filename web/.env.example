# Where the REST API lives, as seen by the browser.
#
# Leave as "/api" for the standard deployment: Caddy serves the built site and
# reverse-proxies /api/* to the .NET API on the same origin, so no CORS is involved.
# Point it at https://api.sat-vocab.alantao.com only if you deliberately split the
# origins — then the API must also list this app's origin in Auth:AllowedOrigins.
VITE_API_BASE_URL=/api

# Dev only: where `npm run dev` proxies /api to. Defaults to http://127.0.0.1:5080.
VITE_DEV_API_TARGET=http://127.0.0.1:5080
